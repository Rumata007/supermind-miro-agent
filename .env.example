# Access token from a Miro app installed on your workspace.
# Get one at https://developers.miro.com/docs/getting-started — needs
# boards:read and boards:write scopes. See README > Get a Miro REST API Token.
MIRO_API_TOKEN=your_miro_api_token

# The board ID from your Miro board URL: miro.com/app/board/<THIS_PART>/
MIRO_BOARD_ID=your_board_id

# Full URL of the board (used to build moveToWidget links back to items).
MIRO_BOARD_URL=https://miro.com/app/board/your_board_id/
